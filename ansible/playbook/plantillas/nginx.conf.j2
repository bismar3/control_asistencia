# Configuracion de Nginx - GENERADO por Ansible
server {
    listen 80 default_server;
    root /var/www/app;
    index index.html;

    client_max_body_size 20M;

    # React: cualquier ruta (/login, /dashboard...) carga index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API GraphQL -> Django en el servidor BACKEND
    location /graphql {
        proxy_pass http://{{ backend_host }}:{{ puerto_backend }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /media {
        proxy_pass http://{{ backend_host }}:{{ puerto_backend }};
        proxy_set_header Host $host;
    }

    location /admin {
        proxy_pass http://{{ backend_host }}:{{ puerto_backend }};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /static {
        proxy_pass http://{{ backend_host }}:{{ puerto_backend }};
        proxy_set_header Host $host;
    }
}