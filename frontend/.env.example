# Copia este archivo como .env.local si necesitas cambiar algún valor.

# Backend Django al que el servidor de Vite reenvía /graphql/ durante el desarrollo.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Endpoint GraphQL que usa Apollo Client. Por defecto es relativo (/graphql/) y pasa por el proxy de Vite,
# lo que permite abrir la app desde otro dispositivo de la red (npm run dev -- --host).
# En producción apunta a la URL pública del backend, por ejemplo: https://api.midominio.com/graphql/
VITE_GRAPHQL_URL=/graphql/

# Zona horaria del backend (settings.TIME_ZONE). Se usa para calcular "hoy" igual que el servidor.
VITE_APP_TIMEZONE=America/La_Paz
